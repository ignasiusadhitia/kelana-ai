# ==============================================================================
# KelanaAI Frontend Environment Variables Template
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# ==============================================================================

# Backend FastAPI Service URL (Used by Next.js Server-Side BFF Proxy Handlers)
# Local development default: http://127.0.0.1:8000
# Production on Vercel: https://api.your-domain.fastapicloud.com (no trailing slash)
BACKEND_URL=http://127.0.0.1:8000

# Public Base URL for Next.js application
# Local development default: http://localhost:3000
# Production on Vercel: https://kelana-ai-ignasiusadhitia.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000
