# ==============================================================================
# KelanaAI Backend Environment Variables Template
# Copy this file to .env for local development:
# cp .env.example .env
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS Bedrock Foundation Model & RAG Service
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
MODEL_ID=amazon.nova-lite-v1:0
KNOWLEDGE_BASE_ID=your_knowledge_base_id_here
KNOWLEDGE_BASE_MODEL_ARN=arn:aws:bedrock:ap-southeast-2::foundation-model/amazon.nova-lite-v1:0
RAG_SEMANTIC_THRESHOLD=0.735

# JWT Authentication & Session Lifetime
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
# Token lifetime in minutes (10080 = 7 days, synchronized with frontend HttpOnly cookie maxAge)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated)
# In production, specify your Vercel deployment domain
CORS_ORIGINS=https://kelana-ai-ignasiusadhitia.vercel.app,http://localhost:3000,http://127.0.0.1:3000
