# ==============================================================================
# KelanaAI Backend Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS Bedrock & Knowledge Base RAG
AWS_REGION=ap-southeast-2
MODEL_ID=amazon.nova-lite-v1:0
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
KNOWLEDGE_BASE_ID=your_kb_id_here
KNOWLEDGE_BASE_MODEL_ARN=arn:aws:bedrock:ap-southeast-2::foundation-model/amazon.nova-lite-v1:0
RAG_SEMANTIC_THRESHOLD=0.735

# JWT Authentication
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://kelana-ai-ignasiusadhitia.vercel.app/,http://localhost:3000,http://127.0.0.1:3000
